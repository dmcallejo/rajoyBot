BOT_TOKEN=replace-with-token-from-botfather
# SQLite by default. For MariaDB, use the compose override or set:
# DATABASE_URL=mysql+aiomysql://rssbot:password@mariadb:3306/rssbot
DATABASE_URL=sqlite+aiosqlite:///./data/rss-to-tg.sqlite3

DEFAULT_INTERVAL_MINUTES=30
MIN_INTERVAL_MINUTES=5
MAX_INTERVAL_MINUTES=1440
POLL_TICK_SECONDS=30
MAX_ARTICLES_PER_POLL=10
POST_EXISTING_ON_FIRST_RUN=false
REQUEST_TIMEOUT_SECONDS=20
